CREATE DATABASE nutrition_tracker;

CREATE TABLE Users (
    userID INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    age INT NOT NULL,
    gender VARCHAR(20) NOT NULL,
    height FLOAT NOT NULL,
    weight FLOAT NOT NULL
);

CREATE TABLE Foods (
    foodID INT AUTO_INCREMENT PRIMARY KEY,
    foodName VARCHAR(100) NOT NULL,
    category VARCHAR(50) NOT NULL,
    servingSize FLOAT NOT NULL,
    servingUnit VARCHAR(10) NOT NULL
);

CREATE TABLE Nutrient (
    nutrientID INT AUTO_INCREMENT PRIMARY KEY,
    nutrientName VARCHAR(100) NOT NULL UNIQUE,
    unit VARCHAR(10) NOT NULL,
    recommendedAmount FLOAT NOT NULL CHECK (recommendedAmount > 0),
    upperLimit FLOAT NULL
);

-- Added to support Nutrient.getRecommendedAmount(age, gender).
-- If no row matches, Nutrient.recommendedAmount is used instead.
CREATE TABLE NutrientRecommendation (
    recommendationID INT AUTO_INCREMENT PRIMARY KEY,
    nutrientID INT NOT NULL,
    gender VARCHAR(20) NOT NULL,
    minAge INT NOT NULL,
    maxAge INT NOT NULL,
    amount FLOAT NOT NULL CHECK (amount > 0),
    FOREIGN KEY (nutrientID) REFERENCES Nutrient(nutrientID) ON DELETE CASCADE
);

CREATE TABLE FoodNutrient (
    foodNutrientID INT AUTO_INCREMENT PRIMARY KEY,
    foodID INT NOT NULL,
    nutrientID INT NOT NULL,
    amountPer100g FLOAT NOT NULL,
    unit VARCHAR(10) NOT NULL,
    UNIQUE (foodID, nutrientID),
    FOREIGN KEY (foodID) REFERENCES Foods(foodID) ON DELETE CASCADE,
    FOREIGN KEY (nutrientID) REFERENCES Nutrient(nutrientID) ON DELETE CASCADE
);

CREATE TABLE IntakeRecords (
    recordID INT AUTO_INCREMENT PRIMARY KEY,
    userID INT NOT NULL,
    foodID INT NOT NULL,
    quantity FLOAT NOT NULL,
    unit VARCHAR(10) NOT NULL,
    intakeDate DATE NOT NULL,
    mealType VARCHAR(20) NOT NULL,
    FOREIGN KEY (userID) REFERENCES Users(userID) ON DELETE CASCADE,
    FOREIGN KEY (foodID) REFERENCES Foods(foodID)
);

CREATE TABLE DailyNutrientSummary (
    summaryID INT AUTO_INCREMENT PRIMARY KEY,
    userID INT NOT NULL,
    nutrientID INT NOT NULL,
    intakeDate DATE NOT NULL,
    intakeAmount FLOAT NOT NULL,
    percentage FLOAT NOT NULL,
    status VARCHAR(20) NOT NULL,
    UNIQUE (userID, nutrientID, intakeDate),
    FOREIGN KEY (userID) REFERENCES Users(userID) ON DELETE CASCADE,
    FOREIGN KEY (nutrientID) REFERENCES Nutrient(nutrientID) ON DELETE CASCADE
);

CREATE TABLE Report (
    reportID INT AUTO_INCREMENT PRIMARY KEY,
    userID INT NOT NULL,
    startDate DATE NOT NULL,
    endDate DATE NOT NULL,
    FOREIGN KEY (userID) REFERENCES Users(userID) ON DELETE CASCADE
);

